# Unity generates these; they are never committed.
Library/
Temp/
Logs/
Obj/
obj/
bin/
Build/
Builds/
UserSettings/
MemoryCaptures/
Recordings/

# Unity writes its OWN csproj/sln next to the project. The hand-written ones
# under headless/ are committed on purpose -- do not widen these patterns.
/*.csproj
/*.sln
/*.user

# .NET 10 writes the newer XML solution format.
/*.slnx

# Synced from art/ by `make art-sync` -- the .glb files and the manifest live
# in art/ and are copied in at build time. Committing the copy would give the
# repo two of every binary, free to drift.
Assets/StreamingAssets/
Assets/StreamingAssets.meta
