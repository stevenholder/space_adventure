<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless runner for the Sim assembly: the C40 conformance dump and the
       self-checks. Console app, no test framework, same shape as the
       test/*.mjs harnesses, and it runs with no Unity Editor anywhere. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpaceAdventure.SimDump</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

</Project>
