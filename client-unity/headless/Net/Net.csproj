<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the SAME sources Unity compiles via Assets/Net/Net.asmdef.
       Nothing is copied or generated: this project globs them in place, so
       there is one source of truth and two compilers. netstandard2.1 is what
       Unity's compiler accepts unchanged. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>SpaceAdventure.Net</RootNamespace>
    <AssemblyName>Net</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Net/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

  <!-- Unity gets Newtonsoft from com.unity.nuget.newtonsoft-json; this build
       gets the same library from NuGet, so Assets/Net/Defs.cs compiles
       unchanged under both compilers. 13.0.x is what that package wraps. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
