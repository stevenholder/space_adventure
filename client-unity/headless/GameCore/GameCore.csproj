<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the engine-free half of the Game assembly: Assets/Game/Core.
       Unity compiles all of Assets/Game as one assembly via Game.asmdef; this
       project globs only the subfolder that carries no UnityEngine reference,
       so prediction and anything else that is pure arithmetic stays testable
       with no Editor. Files that touch the engine live in Assets/Game
       directly and are deliberately NOT globbed here. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>SpaceAdventure.Game</RootNamespace>
    <AssemblyName>GameCore</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Game/Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
    <ProjectReference Include="../Net/Net.csproj" />
  </ItemGroup>

</Project>
