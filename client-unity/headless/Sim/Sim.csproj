<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the SAME sources Unity compiles via Assets/Sim/Sim.asmdef.
       Nothing is copied or generated: this project globs them in place, so
       there is one source of truth and two compilers. netstandard2.1 is what
       Unity's compiler accepts unchanged. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>SpaceAdventure.Sim</RootNamespace>
    <AssemblyName>Sim</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Sim/**/*.cs" />
  </ItemGroup>

</Project>
