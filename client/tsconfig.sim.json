{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  // src/sim plus the src/net files that headless callers import: the QA
  // harnesses (test/t3-authority.mjs, test/t6-prediction.mjs, test/t6-repro.mjs)
  // and client/tools/dump.ts run these under Node with no DOM. Compiling them
  // here is what makes "no DOM" a build error instead of a runtime crash in a
  // test — the same reason src/sim has always been listed
  // (docs/ARCHITECTURE.md, "Client").
  //
  // netClient.ts is deliberately ABSENT: it owns the WebSocket and is browser-only.
  "include": ["src/universal-globals.d.ts", "src/sim", "src/net/protocol.ts", "src/net/phase2.ts", "src/net/predictor.ts"]
}
