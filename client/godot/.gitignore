# Godot's import cache and the .NET build outputs it drives. Regenerated by
# `godot --import` / `dotnet build`; never committed.
.godot/
*.uid
bin/
obj/
mono_crash.*.json

# SpaceAdventure.sln IS committed: the exporter refuses to run without a
# solution named after the assembly beside project.godot. It holds only the
# game csproj; the solution that builds everything is ../SpaceAdventure.Client.slnx.
/*.sln.DotSettings.user
