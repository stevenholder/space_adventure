# syntax=docker/dockerfile:1
# Build context: repo root (see root Makefile).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY server/ ./
# BUILD_ID is stamped into the binary and served at /version, so a running
# server can be asked WHICH build it is rather than only whether it answers.
# The Makefile passes the git rev; an unset one builds a server that honestly
# says "dev".
ARG BUILD_ID=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath \
      -ldflags="-s -w -X main.buildID=${BUILD_ID}" -o /out/server ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/server /server
EXPOSE 8080 9100
ENTRYPOINT ["/server"]
